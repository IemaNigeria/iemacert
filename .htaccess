# ====================================================================
# IEMA STANDARDS LIMITED (iemacert.com) Apache Server Configuration
# ====================================================================

# 1. Disable bare directory indexing (Fixes security issue of folder browsing)
Options -Indexes

# 2. Prevent access to hidden files and version control
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

# 3. Rewrite Engine On
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ------------------------------------------------------------------
  # A. Redirect iemastandards.com to official https://www.iemacert.com
  # ------------------------------------------------------------------
  RewriteCond %{HTTP_HOST} ^(www\.)?iemastandards\.com$ [NC]
  RewriteRule ^(.*)$ https://www.iemacert.com/$1 [R=301,L]

  # Force HTTPS on iemacert.com
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^(www\.)?iemacert\.com$ [NC]
  RewriteRule ^(.*)$ https://www.iemacert.com/$1 [R=301,L]

  # ------------------------------------------------------------------
  # B. 301 Redirects for Old Site URLs Indexed by Google
  # ------------------------------------------------------------------
  RewriteRule ^aboutus/?$ /about-us/ [R=301,L]
  RewriteRule ^ourservices/?$ /certifications/ [R=301,L]
  RewriteRule ^our-team/?$ /our-team/ [R=301,L]
  RewriteRule ^contactus/?$ /contact-us/ [R=301,L]
  RewriteRule ^certification/?$ /certifications/ [R=301,L]
  RewriteRule ^solutions/?$ /certifications/ [R=301,L]
  RewriteRule ^our-projects/?$ /projects/ [R=301,L]
  RewriteRule ^data-protection-compliance/?$ /data-protection-compliance/ [R=301,L]

  # Legacy standard shortcuts redirecting to descriptive target URLs
  RewriteRule ^iso-9001/?$ /iso-9001-certification-nigeria/ [R=301,L]
  RewriteRule ^iso-14001/?$ /iso-14001-certification-nigeria/ [R=301,L]
  RewriteRule ^iso-45001/?$ /iso-45001-certification-nigeria/ [R=301,L]
  RewriteRule ^iso-27001/?$ /iso-27001-certification-nigeria/ [R=301,L]
  RewriteRule ^iso-22000/?$ /iso-22000-certification-nigeria/ [R=301,L]
  RewriteRule ^iso-22301/?$ /iso-22301-certification-nigeria/ [R=301,L]
  RewriteRule ^iso-37001/?$ /iso-37001-certification-nigeria/ [R=301,L]
  RewriteRule ^iso-50001/?$ /iso-50001-certification-nigeria/ [R=301,L]
  RewriteRule ^iso-13485/?$ /iso-13485-certification-nigeria/ [R=301,L]
  RewriteRule ^iso-20000/?$ /iso-20000-certification-nigeria/ [R=301,L]
  RewriteRule ^iso-29001/?$ /iso-29001-certification-nigeria/ [R=301,L]
  RewriteRule ^iso-41001/?$ /iso-41001-certification-nigeria/ [R=301,L]
  RewriteRule ^iso-27701/?$ /iso-27701-certification-nigeria/ [R=301,L]
  RewriteRule ^ecomark/?$ /ecomark-certification-scheme/ [R=301,L]
  RewriteRule ^pci-dss/?$ /pci-dss-certification-nigeria/ [R=301,L]
  RewriteRule ^testing-inspection/?$ /ndt-testing/ [R=301,L]
  RewriteRule ^training/?$ /lead-auditor-training/ [R=301,L]
  RewriteRule ^inspection/?$ /inspection-services/ [R=301,L]
  RewriteRule ^environmental/?$ /environmental-consultancy-nigeria/ [R=301,L]

  # ------------------------------------------------------------------
  # C. 410 Gone for Old Theme Demo Shop Pages (Lords of Strategy)
  # ------------------------------------------------------------------
  RewriteRule ^product/.*$ - [G,L]

  # ------------------------------------------------------------------
  # D. React SPA Fallback: Route all non-file/dir requests to index.html
  # ------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# ====================================================================
# 4. GZIP Compression (mod_deflate) — Accelerate PageSpeed & LCP
# ====================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/xhtml+xml
  AddOutputFilterByType DEFLATE image/svg+xml image/x-icon
  AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2
</IfModule>

# ====================================================================
# 5. Browser Caching & Expiry (mod_expires & mod_headers)
# ====================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Images, Icons, and Media (1 Year)
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Web Fonts (1 Year)
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  # CSS and JavaScript (1 Month with cache revalidation)
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"

  # HTML & Manifests (Live / Short Cache)
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# ====================================================================
# 6. Enterprise Security Headers (HSTS, CSP, X-Frame, Nosniff)
# ====================================================================
<IfModule mod_headers.c>
  # Enforce HSTS (Strict-Transport-Security) for 1 Year including subdomains
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS

  # Prevent Clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"

  # Prevent MIME-type Sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Cross-Origin Referrer Policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Restrict Unused Sensor Hardware
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Cache-Control optimization for static assets
  <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|webp|avif|js|css|swf|woff|woff2)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
</IfModule>

